# Template de variáveis de ambiente — Restaurante Prato
#
# Copie para `.env` e preencha. NUNCA comite o `.env` (o .gitignore cobre).
# O contrato de verdade é `src/lib/env.ts`: o app valida com zod no boot e
# falha rápido se algo obrigatório faltar ou tiver formato errado.
#
# ⚠️ Use `.env`, NÃO `.env.local`. O Next lê os dois, mas o **Prisma CLI só lê
# `.env`** — e é ele que roda `migrate deploy` no build da Vercel. Uma URL de
# banco que exista só no `.env.local` faz a migração falhar no deploy.
#
# Passo a passo de configuração do Supabase e da Vercel: `docs/RUNBOOK.md`.

# ─── Obrigatórias ───────────────────────────────────────────────────────────

# Conexão de runtime. No Supabase é o pooler em transaction mode, porta 6543.
# ⚠️ NÃO acrescente `connection_limit=1`: o PgBouncer já limita, e forçar isso
# mata o prerender concorrente do build com `P2024`.
# Local (Docker): postgresql://agency:agency@localhost:5433/agency
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão usada só pelo `prisma migrate` — migração não passa pelo pooler de
# transação. No Supabase é o session pooler, porta 5432. Localmente é igual à
# DATABASE_URL.
DIRECT_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Assinatura HS256 da sessão do admin. Mínimo 32 caracteres.
# ⚠️ Gere um NOVO para produção — nunca reaproveite o de desenvolvimento.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Domínio final. Alimenta canonical, sitemap, robots e as imagens de OG.
# É inlinado no build: defina ANTES do primeiro build, senão sai com o valor
# antigo em HTML já gerado.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Trava de indexação ─────────────────────────────────────────────────────
# Libera (ou não) o site para os buscadores. Aceita SOMENTE "true" ou "false";
# qualquer outro valor derruba o boot de propósito, para que um erro de
# digitação não publique o site em silêncio.
#
# ⚠️ O padrão é "false" — o site nasce FECHADO. Ausente ou "false" significa:
# `robots.txt` com `Disallow: /` para todos os agentes, sem `Sitemap:`, e um
# `<meta name="robots" content="noindex, nofollow">` em todas as páginas.
# Isso é intencional: enquanto o `src/content/legal.ts` tiver «PENDENTE» e o
# endereço for um `.vercel.app`, ser indexado sob o domínio errado custa
# semanas para desfazer.
#
# PARA PUBLICAR DE VERDADE: defina `SITE_INDEXABLE=true` nas Environment
# Variables da Vercel (ambiente Production) e **redeploy**. Só mudar a variável
# não basta — `robots.txt` e o metadata são gerados no build, então o valor
# fica congelado no deploy anterior até que um novo build rode.
SITE_INDEXABLE="false"

# ─── Upload de imagem do admin ──────────────────────────────────────────────
# Sem estas, o upload é desabilitado (os campos de URL continuam funcionando).
# Exige também um bucket PÚBLICO no Storage do projeto — por padrão `media`.
# ⚠️ Server-only. Nunca prefixe com NEXT_PUBLIC_.

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=

# Nome do bucket. Opcional: vazio ou ausente = `media`, o bucket que o RUNBOOK
# manda criar. Defina só se o bucket do projeto tiver outro nome — o nome é
# configuração do deploy, não constante de código. Diferencia maiúsculas.
# SUPABASE_BUCKET="media"

# ─── Rate limit dos formulários públicos (Upstash / Vercel KV) ──────────────
# Ausentes → o limitador cai para memória, que NÃO sobrevive entre instâncias
# serverless. Aceitável em desenvolvimento; configure em produção.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── WhatsApp (Evolution) — notificação de lead ─────────────────────────────
# Quem preenche o formulário de contato cai num grupo de WhatsApp.
# O grupo é escolhido no admin, em /admin/leads.

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Link para o inbox externo de conversas, exibido no painel de WhatsApp do admin.
WHATSAPP_INBOX_URL=

# ─── Bootstrap do primeiro admin ────────────────────────────────────────────
# NÃO são lidas pelo app: só pelos scripts `npm run db:set-admin` e `db:seed`.
# ⚠️ Um deploy novo NÃO cria administrador nenhum — o build roda
# `prisma migrate deploy && next build`, nunca o seed. Sem rodar um destes,
# ninguém consegue entrar no painel.
#
#   ADMIN_EMAIL=... ADMIN_PASSWORD=... npm run db:set-admin
#
# O `db:set-admin` exige as duas, recusa senha com menos de 8 caracteres e
# apaga o usuário de placeholder. Prefira ele ao seed.
#
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
#
# O seed usa estas outras, e cai para `changeme123` quando a senha não é
# definida. Essa senha serve para desenvolvimento local e nunca para produção.
#
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# ─── Só desenvolvimento local ───────────────────────────────────────────────
# Porta que o Postgres do docker-compose expõe no host.
DB_PORT=5433
