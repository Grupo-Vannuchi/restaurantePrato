// Prisma schema for the n8x marketing platform.
// Bilingual content is stored as JSON maps shaped like { "pt": "...", "en": "..." }
// and resolved per-request via src/lib/i18n helpers. See src/lib/content.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection. On Supabase use the pooled (Supavisor/pgBouncer) URL on
  // port 6543 with `?pgbouncer=true`. Locally it's the direct Postgres URL.
  url       = env("DATABASE_URL")
  // Direct connection used by `prisma migrate`/`db push` (migrations can't run
  // through the transaction pooler). On Supabase this is the 5432 direct URL;
  // locally it's the same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Marketing content (managed via the admin CMS)
// ---------------------------------------------------------------------------

/// An informational entry (knowledge base / "Informações"): listed in the navbar
/// burger menu and rendered as a standalone article with a sidebar of siblings.
model Information {
  id          String   @id @default(cuid())
  slug        String   @unique
  icon        String // lucide-react icon name, e.g. "Info"
  image       String   @default("") // thematic cover image URL (shown on the card)
  title       Json // LocalizedText
  description Json // LocalizedText
  content     Json     @default("{}") // LocalizedRichText (array of paragraphs per locale)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured, order])
  @@map("informations")
}

/// Uma avaliação de cliente, curada a partir das avaliações públicas do Google.
///
/// `source` e `sourceUrl` são o que separam isto de um depoimento inventado: com
/// o link, o visitante confere a avaliação na origem. Por isso não há `company`
/// nem `role` — cargo e empresa eram de depoimento de agência; quem almoça aqui
/// não tem "Diretor de Marketing, Empresa X".
///
/// ⚠️ Estas avaliações NUNCA entram no structured data: o Google proíbe
/// self-serving reviews (`Review`/`aggregateRating` sobre o próprio negócio, no
/// site dele). Aparecem na página, ficam fora do JSON-LD.
model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  avatarUrl  String?
  rating     Int      @default(5)
  quote      Json // LocalizedText
  /// Onde a avaliação foi publicada, ex.: "Google".
  source     String   @default("Google")
  /// Link direto para a avaliação na origem. Opcional, mas é ele que torna a
  /// citação verificável — o admin insiste nele por hint, não por validação.
  sourceUrl  String?
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("testimonials")
}

/// Uma categoria do cardápio (entradas, pratos, sobremesas, bebidas).
model MenuCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        Json // LocalizedText
  description Json       @default("{}") // LocalizedText, opcional
  order       Int        @default(0)
  published   Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([published, order])
  @@map("menu_categories")
}

/// Um prato. SEM preço: a diretriz do cliente proíbe publicar valores, e o
/// buffet é por quilo — preço por prato não existe como conceito aqui.
model MenuItem {
  id              String       @id @default(cuid())
  slug            String       @unique
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            Json // LocalizedText
  description     Json         @default("{}") // LocalizedText
  image           String       @default("")
  available       Boolean      @default(true)
  order           Int          @default(0)
  tags            String[]     @default([]) // "vegetariano", "picante", …
  /// Descrição longa, para a linha do cardápio digital. A curta (`description`)
  /// é a que vai no card — separar evita truncar texto na grade.
  descriptionLong Json         @default("{}") // LocalizedText
  /// Em que seção do cardápio digital o prato entra.
  kind            MenuItemKind @default(BUFFET)
  /// Dias em que o prato é servido: 1 (segunda) a 5 (sexta); o restaurante não
  /// abre no fim de semana. Vazio = item permanente, servido todos os dias.
  ///
  /// É uma LISTA porque o mesmo prato reaparece na semana — o assado sai
  /// segunda e quinta — e duplicar o cadastro por dia significaria corrigir a
  /// mesma descrição em dois lugares. Substituiu o antigo `weekday`, que só
  /// comportava um dia, e cujo `null` queria dizer "permanente"; aqui quem diz
  /// isso é a lista vazia.
  weekdays        Int[]        @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId, order])
  @@index([available, order])
  @@map("menu_items")
}

/// Uma foto da galeria (salão, fachada, ambiente, pratos). Substitui `Project`,
/// que era um estudo de caso de agência: uma foto não tem cliente, ano, resumo
/// nem página de detalhe.
model GalleryPhoto {
  id        String   @id @default(cuid())
  image     String
  caption   Json     @default("{}") // LocalizedText, opcional
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@map("gallery_photos")
}

// ---------------------------------------------------------------------------
// Leads (contact form submissions)
// ---------------------------------------------------------------------------

/// Em que parte do cardápio o prato aparece. O Prato serve buffet por quilo e
/// tem ilha de massas com preço próprio — são seções diferentes, com regras de
/// preço diferentes, e misturá-las numa lista só obrigaria o leitor da mesa a
/// descobrir sozinho o que é cobrado como.
enum MenuItemKind {
  /// Sai no cardápio da semana, dentro do buffet.
  BUFFET
  /// Ilha de massas, com preço fechado próprio.
  PASTA
  /// Vitrine da home: o que a casa serve sempre, com foto curada. Não entra no
  /// cardápio do dia.
  SHOWCASE
}

enum LeadType {
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
}

model Lead {
  id                 String     @id @default(cuid())
  type               LeadType   @default(CONTACT)
  status             LeadStatus @default(NEW)
  name               String
  email              String
  phone              String?
  company            String? // for CONTACT
  message            String
  tags               String[]   @default([]) // free-form labels applied by admins for triage
  locale             String     @default("pt")
  // --- Attribution (how the lead found the site — first-touch, captured client
  // side into sessionStorage and sent with the form). All optional. ---
  referrer           String? // external referrer host (e.g. google.com), "" = direct
  landingPage        String? // first path of the visit (e.g. /novidades/nova-carta-de-vinhos)
  /// Human label for `landingPage`, resolved + FROZEN at capture (e.g.
  /// "Novidades / Nova carta de vinhos"). Frozen so renaming/deleting content
  /// later doesn't rewrite historical attribution.
  landingLabel       String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  /// Set when this lead was pushed to the sales WhatsApp group (auto or manual).
  /// Null = not delivered yet; drives the "✓ WhatsApp" badge + resend recovery.
  whatsappNotifiedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([type, status, createdAt])
  @@map("leads")
}

/// Singleton config for pushing new site leads to a sales WhatsApp group via
/// Evolution. `instance` is an Evolution instance name; `groupId` is the group
/// JID (`…@g.us`). When `enabled` is false or unset, no auto-notification runs.
model LeadNotificationConfig {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  instance  String? // Evolution instance name that sends the message
  groupId   String? // WhatsApp group JID ("…@g.us")
  groupName String? // group subject, for display in the admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_notification_config")
}
